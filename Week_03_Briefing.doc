<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
<head>
<meta charset="utf-8">
<title>Week 3 Announcement: Exporters & Pricing</title>
<style>
  body { font-family: 'Calibri', 'Segoe UI', Arial, sans-serif; margin: 35px; color: #0f172a; background-color: #ffffff; line-height: 1.6; }
  .header-card { background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); color: #ffffff; padding: 25px; border-radius: 10px; text-align: center; margin-bottom: 20px; }
  h1 { font-size: 24pt; margin: 0 0 8px 0; color: #38bdf8; text-transform: uppercase; }
  .subtitle { font-size: 13pt; color: #94a3b8; font-weight: bold; }
  .badge-bar { margin-top: 15px; }
  .badge { display: inline-block; padding: 6px 14px; background: #1e3a8a; border-radius: 6px; color: #93c5fd; font-size: 10pt; font-weight: bold; margin: 0 5px; }
  .badge-gold { background: #78350f; color: #fde047; }
  h2 { color: #1e40af; border-bottom: 2px solid #e2e8f0; padding-bottom: 6px; font-size: 15pt; text-transform: uppercase; margin-top: 25px; }
  table { border-collapse: collapse; width: 100%; margin: 15px 0; font-size: 11pt; }
  th, td { border: 1px solid #cbd5e1; padding: 12px; text-align: left; }
  th { background-color: #f1f5f9; color: #0f172a; font-weight: bold; text-transform: uppercase; font-size: 10pt; }
  tr:nth-child(even) { background-color: #f8fafc; }
  .rubric-box { background: #f0fdf4; border-left: 4px solid #16a34a; padding: 15px; margin-top: 20px; border-radius: 4px; }
  ul { margin: 8px 0 0 0; padding-left: 20px; }
  li { margin-bottom: 6px; }
</style>
</head>
<body>

